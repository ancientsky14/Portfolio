# Copy to .env.local for local overrides. Never commit .env.local.
#
# The site is a static export for GitHub Pages — there is no server, so there
# are no secrets here and none are needed. The contact form composes an email
# in the visitor's own mail app instead of posting anywhere.

# Absolute site URL, no trailing slash. Drives metadataBase, sitemap.xml and
# robots.txt. The Pages workflow sets https://ancientsky14.github.io/Portfolio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Path prefix the site is served under. Empty locally; the Pages workflow sets
# /Portfolio because the repo is ancientsky14/Portfolio. Set it to empty if
# the site moves to a custom domain.
NEXT_PUBLIC_BASE_PATH=
